generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TrafficSource {
  INSTAGRAM
  TELEGRAM
  WEBSITE
  FRIEND
  OTHER
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model User {
  id          Int       @id @default(autoincrement())
  telegramId  BigInt    @unique
  username    String?
  firstName   String?
  lastName    String?
  phone       String?
  age         Int?
  experience  String?
  goal        String?
  source      TrafficSource @default(OTHER)
  blocked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications CourseApplication[]

  @@index([telegramId])
  @@index([source])
}

model CourseApplication {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  status      ApplicationStatus @default(PENDING)
  name        String
  phone       String
  age         Int?
  experience  String?
  goal        String?
  source      TrafficSource @default(OTHER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model Course {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  description String?
  price       String?
  duration    String?
  startDate   String?
  location    String?
  format      String?
  phone       String?
  telegram    String?
  website     String?
  address     String?
  isActive    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages       CourseStage[]
  technologies Technology[]

  @@index([isActive])
}

model CourseStage {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  intro    String
  topics   String // "\n" bilan ajratilgan mavzular ro'yxati
  order    Int    @default(0)

  @@index([courseId])
}

model Admin {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  role       AdminRole @default(ADMIN)
  createdAt  DateTime  @default(now())
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)
}

model Technology {
  id          Int    @id @default(autoincrement())
  courseId    Int
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  key         String
  emoji       String @default("💻")
  name        String
  description String
  usage       String
  order       Int    @default(0)

  @@unique([courseId, key])
  @@index([courseId])
}

model Project {
  id           Int    @id @default(autoincrement())
  title        String
  description  String
  technologies String
  order        Int    @default(0)
}
